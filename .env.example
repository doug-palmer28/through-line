# Copy to .env and fill in. Never commit .env.
# The backend also reads the project-root .env one folder up (AI Foundations/.env).
PORTKEY_API_KEY=
MODEL_NAME=gpt-6-luna
# Database file (default: data/through_line.db).
THROUGH_LINE_DB=
# Signs sign-in tokens and keys the username hashes. If unset, one is generated into data/secret.key (git-ignored).
THROUGH_LINE_SECRET=
# Set to 1 when served over HTTPS: Secure cookies, no API docs, Content-Security-Policy and HSTS headers.
THROUGH_LINE_HTTPS=0
# Access code needed to start a new organization (leave empty for local use).
THROUGH_LINE_SIGNUP_CODE=
# The shared, view-only example login. Defaults to keystone.demo; set it empty to turn the view-only rule off.
# THROUGH_LINE_DEMO_USERNAME=keystone.demo
